# aardio 编译中间产物
tools/aiRunner/.build/
tools/aiRunner/dist/
# aiRunner 执行结果文件（运行时生成）
*.result.json
aiRunner.result.json
# 编译出的执行器（每人自行 F7 编译，见 README 2.2；如想自带 exe 可删除下面这行）
tools/aiRunner.exe
# lib 目录 junction（指向本机 $AARDIO\lib，每人自建，见 README 2.3；严禁提交）
tools/lib/
# aalint 源码收录（tools/aalint）后同样适用的惯例：编译中间产物/发布 exe/junction 不提交
tools/aalint/.build/
tools/aalint/dist/
tools/aalint/lib/
